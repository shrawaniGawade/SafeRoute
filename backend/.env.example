# ==============================================================================
# SafeRoute Full-Stack Application — Environment Configuration Template
# IMPORTANT: Copy this file to '.env' and fill in real credentials.
# NEVER commit the active '.env' file or secret credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Layer Configuration
# ------------------------------------------------------------------------------
# Option A: Local MongoDB instance (default)
MONGO_URI=mongodb://127.0.0.1:27017/saferoute

# Option B: Docker containerized MongoDB
# MONGO_URI=mongodb://mongo:27017/saferoute

# Option C: MongoDB Atlas Cloud Cluster
# MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_NAME>.mongodb.net/saferoute?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Real Geocoding & Routing Provider Configuration (OpenRouteService)
# ------------------------------------------------------------------------------
ROUTING_PROVIDER=openrouteservice
ROUTING_API_KEY=your_openrouteservice_api_key_here
GEOCODE_COUNTRY=IN

# ------------------------------------------------------------------------------
# AI Machine Learning Service (FastAPI Microservice)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Cryptographic JSON Web Token (JWT) Secrets
# NOTE: In production, generate cryptographically random 64-char strings
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_random_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_random_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Real Email Delivery Service (For 6-digit OTP delivery & password resets)
# Configure either Resend (recommended for Vercel) or SMTP credentials.
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended for Vercel serverless)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="SafeRoute Security <onboarding@resend.dev>"

# Option B: SMTP Gateway (Gmail, SendGrid, AWS SES, Brevo, custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="SafeRoute Security <no-reply@yourdomain.com>"

# ------------------------------------------------------------------------------
# Frontend Application URL (For CORS credential validation)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Default Administrator Seed Account
# Used by database initialization to seed initial admin clearance
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="SafeRoute System Administrator"
