PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/saferoute

# AI Service Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# JWT Configuration
JWT_ACCESS_SECRET=saferoute_dev_access_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=saferoute_dev_refresh_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email Configuration (If empty, Ethereal test accounts/console logging are used)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SafeRoute Security <no-reply@saferoute.com>"

# Frontend URL (for CORS credentials support)
FRONTEND_URL=http://localhost:5173

# Default Admin Account
ADMIN_EMAIL=admin@saferoute.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME="SafeRoute Admin"
