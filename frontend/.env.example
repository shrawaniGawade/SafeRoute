# ==============================================================================
# SafeRoute Frontend — Environment Configuration Template
# For production deployment on Vercel, set these in Project Settings -> Environment Variables.
# In local development, copy this file to '.env' or rely on default Vite proxy to localhost:5000.
# ==============================================================================

# Backend API Gateway Base URL (e.g., https://your-backend-project.vercel.app/api)
# Note: In local dev, leave blank or unset to automatically proxy to local backend via '/api'.
VITE_API_BASE_URL=https://your-saferoute-backend.vercel.app/api
